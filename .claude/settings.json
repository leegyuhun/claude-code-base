{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(cmd /c *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(copy *)",
      "Bash(xcopy *)",
      "Bash(git commit *)",
      "Bash(git * main)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Read",
      "Search",
      "Bash(grep *)",
      "Bash(findstr *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pretooluse-bash-guard.py",
            "statusMessage": "셸 위험 명령 검사 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/posttooluse-fast-gate.py",
            "statusMessage": "빠른 검사(fast_check) 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-loop-gate.py",
            "timeout": 660,
            "statusMessage": "루프 게이트 검사 중..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/precompact-preserve.py",
            "statusMessage": "작업 좌표 보존 중..."
          }
        ]
      }
    ]
  }
}
