{
  "permissions": {
    "allow": [
      "Bash",
      "Bash(npm run:*)",
      "Bash(git commit *)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(curl *)",
      "Bash(mkdir *)",
      "Read",
      "Search",
      "Bash(grep *)",
      "Bash(findstr *)",
      "WebSearch",
      "WebFetch",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-Service *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-Help *)",
      "PowerShell(Get-Variable *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Resolve-Path *)",
      "PowerShell(Select-String *)",
      "PowerShell(ls *)",
      "PowerShell(dir *)",
      "PowerShell(cat *)",
      "PowerShell(ps *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; d=json.load(sys.stdin); f=d.get('tool_input',{}).get('file_path',''); blocked=f.endswith(('.pas','.dfm')); print('[CP949] Write tool blocked on .pas/.dfm - use Edit tool or Python cp949 method') if blocked else None; sys.exit(2 if blocked else 0)\"",
            "statusMessage": "CP949 파일 보호 검사 중..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; d=json.load(sys.stdin); f=d.get('tool_input',{}).get('file_path',''); blocked=f.endswith(('.pas','.dfm')); print('[CP949] Edit tool blocked on .pas/.dfm - ASCII-only changes also corrupt CP949. Use Python cp949 method.') if blocked else None; sys.exit(2 if blocked else 0)\"",
            "statusMessage": "CP949 파일 Edit 차단 검사 중..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pretooluse-bash-guard.sh",
            "statusMessage": "Bash 위험 명령 검사 중..."
          }
        ]
      }
    ]
  },
  "env": {
    "GITLAB_TOKEN": "<GITLAB_TOKEN>",
    "REDMINE_URL": "https://redmine.ubware.com",
    "REDMINE_API_KEY": "<REDMINE_API_KEY>"
  },
  "enabledMcpjsonServers": [
    "gitlab",
    "redmine"
  ]
}
